#!/usr/bin/env bash
# .githooks/pre-commit: refuse to commit *.sops.yaml files that aren't encrypted
set -euo pipefail

fail=0
while IFS= read -r -d '' f; do
  # Check the staged blob (":$f"), not the working tree copy
  if ! git show ":$f" | grep -q '^sops:'; then
    echo "✗ $f is not SOPS-encrypted. Run: sops -e -i $f" >&2
    fail=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.sops.yaml' ':(exclude,glob)**/.sops.yaml')

exit $fail
