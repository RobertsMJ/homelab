{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // `# renovate: datasource=... depName=...` above a *_VERSION env var in a workflow
    "customManagers:githubActionsVersions",
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.ya?ml$/"],
  },
  customManagers: [
    {
      // Gateway API CRD bundles in kustomize resources
      customType: "regex",
      description: "GitHub release assets in kustomize resources",
      managerFilePatterns: ["/(^|/)kustomization\\.ya?ml$/"],
      matchStrings: [
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/(?<currentValue>[^/\\s]+)/",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      // scylla clusters
      customType: "regex",
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)(?: versioning=(?<versioning>.*?))?\\s+(?:version|agentVersion):\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
  packageRules: [
    {
      matchDepNames: ["kubernetes-sigs/gateway-api"],
      minimumReleaseAge: "14 days",
      prBodyNotes: [
        "Check that the installed Istio release supports this Gateway API version before merging.",
      ],
    },
    {
      matchFileNames: [".github/workflows/**"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
    },
    {
      matchPackageNames: ["ghcr.io/robertsmj/charts/simc"],
      versioning: "semver",
      ignoreUnstable: false,
      automerge: true,
    },
    {
      matchDepNames: [
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack",
        "nui",
        "ghcr.io/nats-nui/nui",
      ],
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "2 days",
      automerge: true,
    },
    {
      matchDepNames: ["quay.io/jetstack/charts/cert-manager"],
      matchUpdateTypes: ["patch"],
      minimumReleaseAge: "2 days",
      automerge: true,
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["scylladb/scylla", "scylladb/scylla-manager-agent"],
      allowedVersions: "/^[0-9]{4}\\.[0-9]+\\.[0-9]+$/",
      separateMultipleMinor: true,
      separateMultipleMajor: true,
      automerge: false,
    },
  ],
}
