{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // `# renovate: datasource=... depName=...` above a *_VERSION env var in a workflow
    "customManagers:githubActionsVersions",
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.ya?ml$/"],
  },
  customManagers: [
    {
      // Gateway API CRD bundles in kustomize resources
      customType: "regex",
      description: "GitHub release assets in kustomize resources",
      managerFilePatterns: ["/(^|/)kustomization\\.ya?ml$/"],
      matchStrings: [
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/(?<currentValue>[^/\\s]+)/",
      ],
      datasourceTemplate: "github-releases",
    },
  ],
  packageRules: [
    {
      matchDepNames: ["kubernetes-sigs/gateway-api"],
      minimumReleaseAge: "14 days",
      prBodyNotes: [
        "Check that the installed Istio release supports this Gateway API version before merging.",
      ],
    },
    {
      matchFileNames: [".github/workflows/**"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
    },
    {
      matchDepNames: [
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack",
        "nui",
        "ghcr.io/nats-nui/nui",
      ],
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "2 days",
      automerge: true,
    },
    {
      matchDepNames: ["quay.io/jetstack/charts/cert-manager"],
      matchUpdateTypes: ["patch"],
      minimumReleaseAge: "2 days",
      automerge: true,
    },
  ],
}
